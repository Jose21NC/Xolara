sequenceDiagram
    autonumber
    participant User as User
    participant App as App.tsx<br/>(State Machine)
    participant Explore as ExploreScreen
    participant Card as ExperienceCard
    participant Detail as DetailScreen
    participant Reserv as ReservationScreen
    participant Valid as Zod Validation
    participant Handler as handleConfirmBooking
    participant Confirmed as ConfirmedScreen

    User->>Explore: Open app
    App->>Explore: Render (activeTab=explore, currentScreen=explore)

    User->>Card: Tap experience card
    Card->>App: setCurrentScreen('detail')
    Note over App: currentScreen overrides activeTab<br/>Bottom nav hidden
    App->>Detail: Render DetailScreen(experience)

    User->>Detail: Tap "Reservar" button
    Detail->>App: setCurrentScreen('reservation')
    App->>Reserv: Render ReservationScreen(experience)

    User->>Reserv: Fill form<br/>(date, time, adults, children)
    User->>Reserv: Tap "Confirmar Reserva"

    Reserv->>Valid: validate(bookingSchema, formData)
    alt Validation fails
        Valid-->>Reserv: { success: false, errors: [...] }
        Reserv->>User: Show validation errors
    else Validation succeeds
        Valid-->>Reserv: { success: true, data: BookingInput }
        Reserv->>Handler: handleConfirmBooking(validatedData)

        Note over Handler: Generate booking.id = 'bk-'<br/>Generate bookingRef = 'XLR-'<br/>Calculate totalPrice<br/>Set status = 'Confirmed'

        Handler->>App: setBookings([...bookings, newBooking])
        Handler->>App: setCurrentScreen('confirmed')
        App->>Confirmed: Render ConfirmedScreen(booking)
        Confirmed->>User: Display confirmation<br/>+ booking reference
    end
