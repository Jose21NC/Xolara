%% ⚠️ AVISO — Diagrama de CLASES de TypeScript + esquema DB.
%% Las entidades de DB son tablas PostgreSQL reales (supabase/seed.sql).
%% Los módulos de backend son servicios Express en backend/src/.
%%
%% WARNING — TypeScript + DB schema class diagram.
%% DB entities are real PostgreSQL tables (supabase/seed.sql).
%% Backend modules are Express services in backend/src/.

classDiagram
    class Experience_DB {
        <<DB Table>>
        +UUID id PK
        +string title
        +string location
        +string country
        +enum category
        +string duration
        +number duration_hours
        +string group_size
        +number rating
        +number price_per_person
        +string image
        +string about_community
        +jsonb what_you_will_do
        +jsonb community_impact_bullets
        +jsonb how_to_get_there
        +string[] tags
        +UUID created_by FK
        +number lat
        +number lng
    }

    class Booking_DB {
        <<DB Table>>
        +UUID id PK
        +UUID user_id FK
        +UUID experience_id FK
        +date date
        +time time
        +int adults_count
        +int children_count
        +number total_price
        +string booking_ref
        +enum status
        +timestamptz confirmed_at
    }

    class Profile_DB {
        <<DB Table>>
        +UUID id PK FK
        +string display_name
        +enum role
        +string avatar_url
    }

    class PassportStamp_DB {
        <<DB Table>>
        +UUID id PK
        +UUID user_id FK
        +string title
        +string category
        +string icon_type
        +string color
        +UUID booking_id FK
    }

    class ExpressAPI {
        <<Backend>>
        +POST /api/auth/signup
        +POST /api/auth/signin
        +GET  /api/auth/me
        +PATCH /api/auth/profile
        +GET  /api/experiences
        +GET  /api/experiences/:id
        +POST /api/experiences
        +PUT  /api/experiences/:id
        +DELETE /api/experiences/:id
        +GET  /api/bookings
        +POST /api/bookings
        +PUT  /api/bookings/:id
        +DELETE /api/bookings/:id
        +GET  /api/likes
        +POST /api/likes/:id
        +GET  /api/passport
        +GET  /api/guides/:id
        +GET  /api/config
        +PUT  /api/config
    }

    class AuthMiddleware {
        <<Backend>>
        +jwt.verify(token, JWT_SECRET)
        +extract userId + userRole
        +check RBAC permissions
    }

    class Validators {
        <<Backend>>
        +signUpSchema Zod
        +signInSchema Zod
        +bookingSchema Zod
        +experienceSchema Zod
        +configSchema Zod
    }

    class AuthContext {
        <<Frontend>>
        +signIn(email, password)
        +signUp(email, password, name, role)
        +signOut()
        +user: User
        +token: string
    }

    class APIClient {
        <<Frontend>>
        +apiFetch<T>(path, options)
        +auto JWT injection
        +authApi, experiencesApi, bookingsApi
        +likesApi, passportApi, guidesApi, configApi
    }

    class AdminPanelScreen {
        <<Frontend>>
        +list/grid of experiences (guide/admin)
        +edit, delete, create actions
        +role-gated (guide/admin)
    }

    class CreateExperienceScreen {
        <<Frontend>>
        +create mode / edit mode
        +Zod validation
        +POST or PUT depending on editExperience prop
    }

    Booking_DB --> Experience_DB : FK experience_id
    Booking_DB --> Profile_DB : FK user_id
    PassportStamp_DB --> Profile_DB : FK user_id
    PassportStamp_DB --> Booking_DB : FK booking_id

    AuthMiddleware --> ExpressAPI : protects routes
    Validators --> ExpressAPI : validates input
    ExpressAPI --> Booking_DB : SQL
    ExpressAPI --> Experience_DB : SQL

    AuthContext --> APIClient : uses
    APIClient --> ExpressAPI : HTTP + JWT
