# ──────────────────────────────────────────────
# Xolara — Environment Variables
# ──────────────────────────────────────────────

# --- PostgreSQL (Supabase DB) ---
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supabase

# --- JWT (shared secret for GoTrue + backend verification) ---
JWT_SECRET=super-secret-jwt-key-change-in-production

# --- Supabase API Keys (JWTs signed with JWT_SECRET) ---
# Generate with: scripts/generate-keys.sh
SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc0MDAwMDAwMCwicm9sZSI6ImFub24ifQ.3rVzS2G_HudbMmiPq2tRDHjB0zTYmBf_nwFgcNzUTW0
SUPABASE_SERVICE_ROLE_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc0MDAwMDAwMCwicm9sZSI6InNlcnZpY2Vfcm9sZSJ9.HWdDmGZOZXrG4voA26MIsPWiym0CT74p6RSSP8kUPJc

# --- GoTrue (Supabase Auth) ---
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_JWT_EXP=3600
GOTRUE_MAILER_AUTOCONFIRM=true

# --- Backend API ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=http://localhost:9999
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
VITE_API_URL=http://localhost:4000
